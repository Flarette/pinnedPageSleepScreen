# Sleep-clock companion — carries EVERYTHING that touches system folders,
# so the main mod stays reviewable as pure mod space. What it does:
#   /usr/lib/systemd/system-sleep/sleep-zz-pinsleep.sh  (NEW) shrink the EPD
#       rail keep-alive (vpdd 30000->50) during battery sleep so the 34s
#       re-suspend never aborts; stock behavior on USB power / user wakes.
#   /usr/lib/systemd/system-sleep/sleep-wifi.sh    (REPLACES stock) adds a
#       gate: skip the WiFi/BT driver reload on RTC clock wakes on battery.
#       Genuine stock copy kept at /home/root/.pinnedSleepScreen/
#       sleep-wifi.sh.stock (OUTSIDE the hook dir — systemd-sleep executes
#       every file in it) and restored on uninstall / refreshed on OTA.
#   /etc/systemd/system/pinsleep-clock.{service,timer}  5-min WakeSystem
#       timer (the wake itself repaints the clock; service is /bin/true).
#       Written to the REAL rootfs /etc via mount-utils (the /etc overlay
#       upper is tmpfs — anything written through it dies on reboot).
# Package data lands only in /home/root/.vellum/share; all system writes
# happen in the lifecycle functions, so `vellum del` reverts cleanly.
maintainer="Yan Kotliarov <yan.geruch@gmail.com>"
pkgname=pinned-sleep-clock
pkgver=0.46.1
pkgrel=0
upstream_author="Flarette"
category="ui"
pkgdesc="System hooks + 5-min wake timer for the pinned-page-sleep-screen clock bar"
url="https://github.com/$upstream_author/pinnedPageSleepScreen"
arch="aarch64"
license="GPL-3.0-or-later"
# sysfs paths in the hooks (g2194 EPD PMIC, slg46824 wakeup reason) are
# Paper Pro Move + OS 3.27 specific; sleep-wifi.sh embeds the 3.27 stock hook.
# The core pin (>= same release) exists because the two are cut together:
# an unpinned depends let a new companion sit against an old core whose qmd
# lacks the timer re-assert contract these hooks now rely on.
depends="pinned-page-sleep-screen>=$pkgver mount-utils rmppmove
	remarkable-os>=3.27 remarkable-os<3.28"
_release="v$pkgver"
_raw="https://raw.githubusercontent.com/$upstream_author/pinnedPageSleepScreen/$_release"
readmeurl="$_raw/README.md"
source="
$_raw/packaging/pinned-sleep-clock/install.sh
$_raw/packaging/pinned-sleep-clock/uninstall.sh
$_raw/assets/system-sleep/sleep-zz-pinsleep.sh
$_raw/assets/system-sleep/sleep-wifi.sh
$_raw/assets/systemd/pinsleep-clock.service
$_raw/assets/systemd/pinsleep-clock.timer
$_raw/LICENSE
"
options="!check"

package() {
	local share="$pkgdir"/home/root/.vellum/share/$pkgname
	install -Dm755 "$srcdir"/install.sh          "$share"/install.sh
	install -Dm755 "$srcdir"/uninstall.sh        "$share"/uninstall.sh
	install -Dm755 "$srcdir"/sleep-zz-pinsleep.sh "$share"/sleep-zz-pinsleep.sh
	install -Dm755 "$srcdir"/sleep-wifi.sh       "$share"/sleep-wifi.sh
	install -Dm644 "$srcdir"/pinsleep-clock.service "$share"/pinsleep-clock.service
	install -Dm644 "$srcdir"/pinsleep-clock.timer   "$share"/pinsleep-clock.timer

	install -Dm644 "$srcdir"/LICENSE \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "$url/archive/refs/tags/$_release.tar.gz" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	/home/root/.vellum/share/pinned-sleep-clock/install.sh
}

postupgrade() {
	postinstall
}

predeinstall() {
	/home/root/.vellum/share/pinned-sleep-clock/uninstall.sh
}

postosupgrade() {
	# `vellum reenable` after an OTA replaced the rootfs: our hooks are gone
	# and the OS's own (possibly newer) sleep-wifi.sh is back. Drop the old
	# stock backup so install.sh re-captures the NEW stock before re-gating.
	rm -f /home/root/.pinnedSleepScreen/sleep-wifi.sh.stock
	/home/root/.vellum/share/pinned-sleep-clock/install.sh
}
